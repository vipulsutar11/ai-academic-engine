# Primary LLM: Mistral AI (https://console.mistral.ai/)
# Supported models: mistral-large-latest, mistral-small-latest, open-mistral-7b, codestral-latest
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_NAME=mistral-large-latest
MISTRAL_API_BASE=https://api.mistral.ai/v1

# Fallback LLM: Google Gemini
# Supported models: gemini-2.5-flash, gemini-3.8-flash, gemini-2.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# RAG & Embedding Settings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_DIR=./data/vector_store
TOP_K_RETRIEVAL=5

# Semantic Duplicate Threshold
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# Quality Threshold
QUALITY_PASS_THRESHOLD=0.75

# Board Profiles Path
BOARD_PROFILES_DIR=./data/board_profiles

# Environment
APP_ENV=development
LOG_LEVEL=INFO
